# --- Secrets (never commit) -------------------------------------------------------------------
.env
.env.*
!.env.example

# --- Local native runtime (Postgres data, Tesseract, micromamba env, uploaded files) ----------
.runtime/
data/

# --- Python -------------------------------------------------------------------------------------
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ----------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/dev-dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
*.tsbuildinfo

# --- Evaluation output (reports are regenerated by `make eval`) --------------------------------
eval/reports/*
!eval/reports/.gitkeep

# --- Editors / OS -------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
