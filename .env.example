# ProtoCite configuration. Copy to .env and edit. Every value has a safe default for local demos.
# Never commit .env — it holds your API key. Lines marked (prod) matter only for real deployments.

# --- App -------------------------------------------------------------------------------------------
# dev | test | prod (prod refuses the default SECRET_KEY and dev sign-in)
APP_ENV=dev
API_BASE_URL=http://localhost:8001
# allowed CORS origin when the UI runs on the Vite dev server
WEB_BASE_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=
# (prod) long random string; signs session tokens
SECRET_KEY=change-me
# demo sign-in: pick a seeded user, no password. false in prod
DEV_AUTH=true
# shared ward terminals lock themselves after this much inactivity
SESSION_IDLE_MINUTES=15

# --- Database / storage ----------------------------------------------------------------------------
# Native Windows runtime (protocite.ps1) uses Postgres on port 5433; Docker uses db:5432.
DATABASE_URL=postgresql+asyncpg://protocite:protocite@127.0.0.1:5433/protocite
# only used when INGEST_INLINE=false (arq worker)
REDIS_URL=redis://127.0.0.1:6379/0
# original uploaded files
STORAGE_DIR=./.runtime/storage
# true = process uploads inside the API (no Redis needed)
INGEST_INLINE=true
# built UI served by the API when present
# WEB_DIST_DIR=../frontend/dist

# --- OCR (scanned PDFs) ----------------------------------------------------------------------------
# e.g. D:/protocite/.runtime/env/Library/bin/tesseract.exe
TESSERACT_CMD=
# folder with eng/hin .traineddata files
TESSDATA_PREFIX=
OCR_LANGUAGES=eng+hin
# below this a scanned page needs an author's acknowledgement
OCR_MIN_CONFIDENCE=0.80

# --- Answer model (LLM) ----------------------------------------------------------------------------
# gemini | anthropic | ollama | none (none = quote-only extractive answers)
LLM_PROVIDER=gemini
# from Google AI Studio; paste it here yourself, never in chat
GEMINI_API_KEY=
# Comma-separated fallback chains: a rate-limited or unavailable model is skipped for a cool-down.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
# (prod) Vertex AI pins processing to a region for data residency
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-south1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Per-stage time budgets in seconds; past a budget the stage falls back to its deterministic path.
LLM_BUDGET_CLASSIFY_S=6
LLM_BUDGET_GENERATE_S=15
LLM_BUDGET_VERIFY_S=10
LLM_BUDGET_CONFLICT_S=10
# batch = one judge call for all claims; per_claim = one call each
VERIFIER_MODE=batch

# --- Retrieval models ------------------------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-base
# auto | cpu | cuda
MODEL_DEVICE=auto
# true after the first run: start without touching the network
HF_HUB_OFFLINE=false
# optional extra entailment check (downloads another model)
NLI_ENABLED=false

# --- Safety thresholds -----------------------------------------------------------------------------
# below this the best passage is "not found" → abstain
MIN_RELEVANCE=0.35
# minimum support score for a sentence to stay in the answer
VERIFIER_THRESHOLD=0.8
CONFLICT_MIN_CONFIDENCE=0.7
# presidio | regex
PII_REDACTION_ENGINE=presidio

# --- Limits / retention / logs ---------------------------------------------------------------------
QUERY_RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_CHARS=1000
MAX_UPLOAD_MB=25
LOG_RETENTION_DAYS=180
LOG_LEVEL=INFO
LOG_JSON=true
OTEL_EXPORTER_OTLP_ENDPOINT=
# pin "today" (YYYY-MM-DD) for demos and evaluation runs
TODAY_OVERRIDE=
